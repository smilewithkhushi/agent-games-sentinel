# Copy to .env. Use a local test secret; use the platform secret only in hosting settings.
AGENT_GAMES_HMAC_SECRET=
REFERENCE_AGENT_MODE=normal
REFERENCE_AGENT_DELAY_MS=0
PORT=3000
CACHE_BACKEND=memory
AGENT_NAMESPACE=reference-local
# Optional: switch to redis if running multiple Railway replicas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ZK proof submission (competition only).
# Get KURIER_API_KEY from your Kurier testnet account.
# Get ZKVERIFY_VFY_VK_HASH after registering the vfy-policy circuit on zkVerify.
KURIER_API_KEY=
ZKVERIFY_VFY_VK_HASH=
