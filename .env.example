# Copy to .env. Use a local test secret; use the platform secret only in hosting settings.
AGENT_GAMES_HMAC_SECRET=
REFERENCE_AGENT_MODE=normal
REFERENCE_AGENT_DELAY_MS=0
PORT=3000
CACHE_BACKEND=memory
AGENT_NAMESPACE=reference-local
# Optional: switch to redis if running multiple Railway replicas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ZK proof submission (competition only).
# The inline Groth16 proof + public_signals are ALWAYS generated for competition turns and do
# not depend on these two vars; KURIER_API_KEY + ZKVERIFY_VFY_VK_HASH only add the optional
# on-chain proofReference anchor. Get KURIER_API_KEY from your Kurier testnet account.
# ZKVERIFY_VFY_VK_HASH defaults to the platform's registered vfy-policy vk hash
# (0x6c56509f...74be047); set it only to override. A stale/placeholder value self-heals to the default.
KURIER_API_KEY=
ZKVERIFY_VFY_VK_HASH=

# Optional: pins the Poseidon strategy-commitment salt independently of the signing secret.
# Set this to the secret that produced the commitment currently REGISTERED on the platform, so
# rotating AGENT_GAMES_HMAC_SECRET (signing) never invalidates the registered commitment. If unset,
# the commitment derives from AGENT_GAMES_HMAC_SECRET (original behavior).
VFY_COMMITMENT_SECRET=
