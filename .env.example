# Copy to .env. Use a local test secret; use the platform secret only in hosting settings.
AGENT_GAMES_HMAC_SECRET=
REFERENCE_AGENT_MODE=normal
REFERENCE_AGENT_DELAY_MS=0
PORT=3000
CACHE_BACKEND=memory
AGENT_NAMESPACE=reference-local
# Required with CACHE_BACKEND=redis; mandatory on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
