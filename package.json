{
  "name": "agent-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:redis": "node --import tsx --test tests/integration/redis.test.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "play": "node --import tsx scripts/play.ts",
    "play:gatekeeper": "node --import tsx scripts/play.ts gatekeeper",
    "commitment": "node --import tsx scripts/commitment.ts",
    "test:http": "node --import tsx --test tests/integration/http.test.ts"
  },
  "dependencies": {
    "fastify": "^5.12.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
